{
  "name": "mergechoice",
  "version": "0.0.1",
  "description": "Merge lists with choices",
  "keywords": [
    "list",
    "merge",
    "sort",
    "choice"
  ],
  "homepage": "https://github.com/davidystephenson/mergechoice#readme",
  "bugs": {
    "url": "https://github.com/davidystephenson/mergechoice/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidystephenson/mergechoice.git"
  },
  "license": "Unlicense",
  "author": "David Y. Stephenson",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "check": "npx tsc && npm run test && npm run deadcode && npm run lint",
    "deadcode": "npx knip --reporter ./my-reporter.js",
    "lint": "npx ts-standard --fix",
    "test": "npx jest --json > jest-results.json && node parse-jest-failures.js",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "rand-seed": "^2.1.7",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.5",
    "jest": "^29.7.0",
    "knip": "^5.45.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-standard": "^12.0.2"
  },
  "ts-standard": {
    "project": "./tsconfig.json"
  },
  "knip": {
    "ignore": [
      "my-reporter.js",
      "tests/**"
    ],
    "ignoreDependencies": [
      "ts-standard",
      "ts-node"
    ]
  }
}
